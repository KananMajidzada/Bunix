#!/usr/bin/env python3
"""bcc - Bunix C cross-compiler driver.

Runs on the host and produces a static x86-64 image linked at 0x400000, in the
shape Bunix's loader wants: a flat blob plus a real ELF for reading the entry
and the image end.

Usage:
    bcc -o out file.c ...      compile and link
    bcc -c file.c              compile to .o
    bcc -E file.c              preprocess only
    bcc --print-search-dirs
"""

import argparse
import os
import subprocess
import sys

# Bunix has no host libc, no dynamic loader, and no FPU state, so the code has
# to be freestanding and scalar. Stack protector stays off: the canary lives in
# %fs, which a Bunix process never sets up.
CFLAGS = [
    "-ffreestanding",
    "-nostdlib",
    "-fno-pic",
    "-fno-pie",
    "-fno-stack-protector",
    "-mno-red-zone",
    "-mno-mmx",
    "-mno-sse",
    "-mno-sse2",
    "-mcmodel=small",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-O2",
]

LDFLAGS = ["-nostdlib", "-static", "-no-pie"]

# Warnings worth turning on for ported code, minus the ones that only make
# noise about a freestanding target.
WARNINGS = [
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter",
    "-Wno-unused-function",
    "-Wno-unused-variable",
    "-Wno-missing-field-initializers",
    "-Wno-implicit-fallthrough",
]


def runtime_dir():
    return os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "..", "..", "userland"
    )


def rt_dir():
    return os.path.join(runtime_dir(), "rt")


def run(cmd, verbose, what):
    if verbose:
        print("bcc: " + " ".join(cmd), file=sys.stderr)
    r = subprocess.run(cmd)
    if r.returncode != 0:
        print(f"bcc: {what} failed", file=sys.stderr)
        sys.exit(r.returncode)


def main():
    p = argparse.ArgumentParser(prog="bcc", add_help=True)
    p.add_argument("-o", "--output")
    p.add_argument("-c", action="store_true", help="compile only")
    p.add_argument("-E", action="store_true", help="preprocess only")
    p.add_argument("-S", action="store_true", help="emit assembly")
    p.add_argument("-k", action="store_true", help="keep intermediates")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("-nostdinc", action="store_true")
    p.add_argument("-I", dest="includes", action="append", default=[])
    p.add_argument("-D", dest="defines", action="append", default=[])
    p.add_argument("-l", dest="libs", action="append", default=[])
    p.add_argument("-L", dest="libdirs", action="append", default=[])
    p.add_argument("--include", default=None,
                   help="directory holding the Bunix runtime headers")
    p.add_argument("--print-search-dirs", action="store_true")
    p.add_argument("inputs", nargs="*")
    args = p.parse_args()

    inc = rt_dir() if args.include is None else args.include
    link_script = os.path.join(rt_dir(), "c.ld")
    libc = os.path.join(rt_dir(), "libc.a")

    if args.print_search_dirs:
        print(f"runtime: {rt_dir()}")
        print(f"headers: {inc}")
        print(f"libc:    {libc}")
        return

    if not args.inputs:
        p.error("no input files")

    cc = os.environ.get("CC", "cc")

    def compile_flags():
        f = list(CFLAGS) + list(WARNINGS) + [f"-I{inc}"]
        if not args.nostdinc:
            # Host headers are still useful for compiler-provided things like
            # stdarg.h and stddef.h.
            f += ["-isystem", os.path.join(sys.prefix, "include")]
        for d in args.defines:
            f.append(f"-D{d}")
        for i in args.includes:
            f.append(f"-I{i}")
        return f

    cf = compile_flags()

    if args.E:
        run([cc, "-E", *cf, *args.inputs], args.verbose, "preprocessing")
        return

    if args.S:
        out = args.output or os.path.splitext(os.path.basename(args.inputs[0]))[0] + ".s"
        run([cc, "-S", *cf, *args.inputs, "-o", out], args.verbose, "compiling")
        return

    # -c stops after compiling each file.
    if args.c:
        out = args.output or os.path.splitext(os.path.basename(args.inputs[0]))[0] + ".o"
        run([cc, "-c", *cf, *args.inputs, "-o", out], args.verbose, "compiling")
        return

    if not os.path.exists(libc):
        print(f"bcc: runtime not built: {libc}", file=sys.stderr)
        print("bcc: run make first", file=sys.stderr)
        sys.exit(1)

    out = args.output or "a.out"
    workdir = os.path.dirname(os.path.abspath(out)) or "."

    objs = []
    for src in args.inputs:
        base = os.path.splitext(os.path.basename(src))[0]
        obj = os.path.join(workdir, base + ".o")
        run([cc, "-c", *cf, src, "-o", obj], args.verbose, f"compiling {src}")
        objs.append(obj)

    link = [cc, *LDFLAGS, "-T", link_script, "-o", out, *objs, libc]
    for d in args.libdirs:
        link.append(f"-L{d}")
    for l in args.libs:
        link.append(f"-l{l}")
    run(link, args.verbose, "linking")

    # Bunix wants the raw bytes too: the kernel folds these into its image and
    # the loader copies them into user memory.
    run(["objcopy", "-O", "binary", out, out + ".bin"], args.verbose, "objcopy")

    if not args.k:
        for obj in objs:
            try:
                os.remove(obj)
            except OSError:
                pass

    print(f"bcc: {out} (+ {out}.bin)")


if __name__ == "__main__":
    main()